{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/bacem/suivi-travaux/main/schema/trk-manifest-2.json",
  "title": "Manifeste de plugin TrkPlugin v2 (trk.extension/2)",
  "description": "Schéma éditeur pour plugins/<id>/manifest.json. Cf. PLUGIN_FORMAT_V2.md § 3.",
  "type": "object",
  "required": ["format", "id", "version", "engines", "name"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "trk.extension/2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "license": { "type": "string" },
    "engines": {
      "type": "object",
      "required": ["api"],
      "additionalProperties": false,
      "properties": {
        "api": { "type": "integer", "minimum": 1 },
        "app": { "type": "string" }
      }
    },
    "name": { "$ref": "#/definitions/localized" },
    "description": { "$ref": "#/definitions/localized" },
    "icon": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "doc", "tasks:read", "task:reveal", "file:save", "toast",
          "fullscreen", "debug", "commands", "settings", "columns", "panels", "state"
        ]
      }
    },
    "locales": {
      "type": "object",
      "properties": { "dir": { "type": "string" }, "default": { "type": "string" } },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docTypes": { "type": "array", "items": { "$ref": "#/definitions/docType" } },
        "views": { "type": "array", "items": { "$ref": "#/definitions/view" } },
        "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } },
        "taskColumns": { "type": "array", "items": { "$ref": "#/definitions/taskColumn" } },
        "taskPanels": { "type": "array", "items": { "$ref": "#/definitions/taskPanel" } },
        "settings": { "type": "object", "additionalProperties": { "$ref": "#/definitions/setting" } }
      }
    }
  },
  "definitions": {
    "localized": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    },
    "docType": {
      "type": "object",
      "required": ["id", "dataVersion"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "dataVersion": { "type": "integer" },
        "migrations": { "type": "string" }
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "#/definitions/localized" },
        "icon": { "type": "string" },
        "kind": { "enum": ["declarative", "app"] },
        "spec": { "type": "string" },
        "entry": { "type": "string" },
        "docType": { "type": "string" },
        "scopes": { "type": "array", "items": { "enum": ["global", "project"] } },
        "singleton": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "#/definitions/localized" },
        "icon": { "type": "string" },
        "when": { "type": "string" }
      }
    },
    "taskColumn": {
      "type": "object",
      "required": ["id", "label", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "$ref": "#/definitions/localized" },
        "value": { "type": "string" },
        "as": { "enum": ["text", "badge", "gauge", "link"] },
        "width": { "type": "string" },
        "tone": { "type": "string" }
      }
    },
    "taskPanel": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "$ref": "#/definitions/localized" },
        "kind": { "enum": ["declarative", "app"] },
        "spec": { "type": "string" },
        "entry": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["enum", "number", "boolean", "string"] },
        "values": { "type": "array", "items": { "type": "string" } },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "label": { "$ref": "#/definitions/localized" }
      }
    }
  }
}
