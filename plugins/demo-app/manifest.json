{
  "$schema": "schema/trk-manifest-2.json",

  "format": "trk.extension/2",

  "id": "demo-app",
  "version": "1.0.0",
  "publisher": "demo",
  "license": "MIT",

  "engines": { "api": 2 },

  "name": { "fr": "Démo (app)", "en": "Demo (app)" },
  "description": {
    "fr": "Plugin d'exemple du tier `app` : module ES servi par l'hôte, pont postMessage.",
    "en": "Example app-tier plugin: host-served ES module, postMessage bridge."
  },
  "icon": "FlaskConical",

  "permissions": ["tasks:read", "commands", "toast", "settings"],

  "contributes": {
    "views": [
      {
        "id": "demo",
        "title": { "fr": "Démo", "en": "Demo" },
        "icon": "FlaskConical",
        "kind": "app",
        "entry": "index.html",
        "scopes": ["global"],
        "singleton": true
      }
    ],
    "commands": [
      {
        "id": "demo.hello",
        "title": { "fr": "Dire bonjour", "en": "Say hello" },
        "icon": "Sparkles"
      }
    ],
    "taskColumns": [
      {
        "id": "demo.minutes",
        "label": { "fr": "Pointé (min)", "en": "Logged (min)" },
        "value": "task.minutes",
        "as": "badge",
        "tone": "#4CAF6D"
      }
    ],
    "taskPanels": [
      {
        "id": "demo.related",
        "title": { "fr": "Panneau démo", "en": "Demo panel" },
        "kind": "declarative",
        "spec": "views/related.trkv"
      }
    ],
    "settings": {
      "demo.greet": {
        "type": "string",
        "default": "Bonjour",
        "label": { "fr": "Message d'accueil", "en": "Greeting" }
      }
    }
  }
}
